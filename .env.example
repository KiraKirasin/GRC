# Copy to `.env` and fill in values. Never commit real secrets.

NODE_ENV=development
DATABASE_URL="file:./grc.db"
PORT=3100
UPLOAD_DIR=./uploads/projects

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=7d

SEED_USER_PASSWORD=grc123
# CONTROLS_XLSX=./NovaPay_Enterprise_Control_Library.xlsx

E2E_BASE_URL=http://127.0.0.1:3100

# Public app URL used in password-reset links (browser origin)
APP_ORIGIN=http://localhost:5200
# Set true to always return resetUrl in forgot-password API (also on in non-production)
# AUTH_EXPOSE_RESET_URL=true

# --- CISO Copilot (Microsoft Azure OpenAI / Copilot stack) ---
# When set, /api/copilot/chat uses Azure OpenAI chat completions.
# Without these, the agent still answers from live GRC DB (local fallback).
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
