# Replace grc.example.com with your domain (or use :443 with a public IP + TLS off until DNS is ready)
{$GRC_DOMAIN:localhost} {
	encode gzip

	# API + SPA are served by the Node app on :3001
	reverse_proxy app:3001

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
