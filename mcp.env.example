# MCP credentials for Cursor (.cursor/mcp.json).
# Export these in your shell before starting Cursor, or add them to your OS user env.
#
# GitLab MCP — OAuth opens in the browser on first connect.
# Self-managed: enable MCP on the instance/group (GitLab Duo + beta features).
# Change URL if you use GitLab.com instead of self-hosted.
GITLAB_MCP_URL=https://gitlab.novapay.ua/api/v4/mcp

# SharePoint MCP — Azure Entra app with Sites.Read.All / Files.ReadWrite.All (or narrower).
# Install server once: pip install sharepoint-mcp   (or: pipx install sharepoint-mcp)
SHP_ID_APP=
SHP_ID_APP_SECRET=
SHP_TENANT_ID=
SHP_SITE_URL=https://your-tenant.sharepoint.com/sites/your-site
# graph | office365 | graphql
SHP_API_TYPE=graph
# Optional: restrict to a document library subfolder (empty = whole library)
SHP_DOC_LIBRARY=
