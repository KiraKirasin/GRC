{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-00000000grc1",
  "developer": {
    "name": "NovaPay",
    "websiteUrl": "https://grc.example.com",
    "privacyUrl": "https://grc.example.com/privacy",
    "termsOfUseUrl": "https://grc.example.com/terms"
  },
  "name": {
    "short": "NovaPay GRC",
    "full": "NovaPay GRC CISO Copilot"
  },
  "description": {
    "short": "GRC compliance agent for Microsoft 365 Copilot",
    "full": "Ask about NovaPay compliance projects, control gaps, evidence coverage, and policies. Grounded in the live GRC API."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0F766E",
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "novapayGrcAgent",
        "file": "declarativeAgent.json"
      }
    ]
  },
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["grc.example.com"]
}
